-    
-    const newValue = !notifPrefs[key];
-    const oldPrefs = { ...notifPrefs };
-    
-    // Optimistic update
-    setNotifPrefs(prev => ({ ...prev, [key]: newValue }));
-    setSavingPrefs(true);
-
-    const payload: MemberNotificationPreferencesInsert = {
-      member_id: profile.id,
