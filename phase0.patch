-function getAssetKindFromName(name: string): 'logo' | 'cover' | null {
-  if (name.startsWith('logo-') && name.endsWith('.jpg')) return 'logo';
-  if (name.startsWith('cover-') && name.endsWith('.jpg')) return 'cover';
-  return null;
-}
