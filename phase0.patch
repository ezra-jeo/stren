-    candidate = window.localStorage.getItem(LOGIN_ORIGIN_STORAGE_KEY)
-  } catch {
-    return null
-  }
-
-  if (!candidate) return null
-
-  if (candidate === "/login") return candidate
-  if (/^\/gym\/[^/]+\/login$/.test(candidate)) return candidate
-
-  return null
-}
