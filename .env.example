# Safe for browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SERVER ONLY — never NEXT_PUBLIC_. Also signs the short-lived password-recovery proof.
# Used by server routes and the deployment preflight. New-format hosted projects
# may provide the equivalent value as SUPABASE_SECRET_KEY instead.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_APP_URL=https://yourdomain.com
