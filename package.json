{
  "name": "my-project",
  "version": "2.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --coverage --maxWorkers=4 --testTimeout=30000",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install",
    "verify:deployment": "node scripts/verify-deployment-contract.mjs",
    "verify:deployment:local": "node scripts/check-local-deployment-contract.mjs",
    "verify:deployment:drift:local": "node scripts/check-local-deployment-drift.mjs",
    "backup:check": "node scripts/backup/verify-backup-freshness.mjs",
    "backup:storage": "node scripts/backup/export-storage.mjs",
    "restore:storage": "node scripts/backup/restore-storage.mjs",
    "verify:storage-restore": "node scripts/backup/verify-storage-restore.mjs",
    "recovery:capture": "node scripts/recovery/capture-recovery-evidence.mjs",
    "recovery:compare": "node scripts/recovery/compare-recovery-evidence.mjs",
    "recovery:drill:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/recovery/run-local-restore-drill.ps1",
    "test:ci": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:e2e",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset --local --no-seed",
    "db:reset:clean": "node scripts/reset-local-database.mjs",
    "db:types:check": "node scripts/check-database-types.mjs",
    "db:test:security": "node scripts/run-production-security-tests.mjs",
    "db:test:financial": "node scripts/run-financial-closure-tests.mjs",
    "db:invariants": "node scripts/run-production-security-tests.mjs && node scripts/run-local-database-invariants.mjs && node scripts/check-local-deployment-contract.mjs && node scripts/check-local-deployment-drift.mjs",
    "db:status": "npx supabase status"
  },
