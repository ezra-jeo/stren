# Local Supabase stack — copy this file to .env.local and fill in the values.
#
# HOW TO GET THESE VALUES:
#   1. npm run db:start          (boots Docker containers)
#   2. npx supabase status       (prints all keys and URLs)
#   3. Copy the values below from that output.
#
# IMPORTANT: .env.local is gitignored. Never commit real keys.
# This file contains placeholder values only and is safe to commit.
#
# To switch back to production, remove (or rename) .env.local so Next.js
# falls back to the real values in your Vercel / hosting environment.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from: npx supabase status>
SUPABASE_SERVICE_ROLE_KEY=<service_role key from: npx supabase status>
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
